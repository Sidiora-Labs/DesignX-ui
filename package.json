{
  "name": "@sidioralabs/designx-ui-react",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/api/index.ts"
  },
  "scripts": {
    "build": "bun scripts/build-registry.ts && node scripts/check-registry.mjs public/r && tsc --noEmit && vite build && node scripts/check-registry.mjs dist/r",
    "check": "bun run lint && bun run typecheck && bun run registry:check && npm --prefix cli run check",
    "lint": "oxlint",
    "dev": "vite",
    "start": "bun src/__server.ts",
    "typecheck": "tsc --noEmit",
    "preview": "bun run build && vite preview",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "registry": "bun scripts/build-registry.ts && node scripts/check-registry.mjs public/r",
    "registry:check": "node scripts/check-registry.mjs public/r"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@floating-ui/dom": "^1.8.0",
    "@libsql/client": "^0.17.2",
    "@orpc/client": "^1.14.7",
    "@orpc/server": "^1.14.7",
    "@orpc/tanstack-query": "^1.14.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@runablehq/website-runtime": "^0.10.0",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-table": "^8.21",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.12.10",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.577.0",
    "motion": "^14.0.0",
    "react": "19.1.0",
    "react-day-picker": "^9.11",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.2",
    "react-icons": "^5.6.0",
    "react-resizable-panels": "^3",
    "react-use-measure": "^2.1.7",
    "recharts": "^3.10.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "wouter": "^3.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.3.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.1.4",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.0",
    "oxlint": "1.85.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.1-rc",
    "vite": "^7.3.1"
  }
}
